# PagerDuty alerting (optional). Leave unset to disable alerts entirely.
# Create an "Events API v2" integration on a PagerDuty service and paste its
# Integration Key (routing key) here. Never commit the real key.
PAGERDUTY_ROUTING_KEY=
# Set to "false" to turn alerts off without removing the key
PAGERDUTY_ENABLED=true
# Minimum ms between alerts for the same component + failure (default 300000 = 5 min)
PAGERDUTY_THROTTLE_MS=300000
