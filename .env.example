# PagerDuty alerting (optional). Leave unset to disable alerts entirely.
# Create an "Events API v2" integration on a PagerDuty service and paste its
# Integration Key (routing key) here. Never commit the real key.
PAGERDUTY_ROUTING_KEY=
# Set to "false" to turn alerts off without removing the key
PAGERDUTY_ENABLED=true
# Minimum ms between alerts for the same component + failure (default 300000 = 5 min)
PAGERDUTY_THROTTLE_MS=300000

# ---- API encryption (AES-256-CBC, same scheme as encryption.utils.js) ----
# Every API request/response body is exchanged as { "encryptedData": "<hex>" }.
# ENCRYPTION_KEY must be exactly 32 characters, ENCRYPTION_IV exactly 16.
# If unset, a built-in DEVELOPMENT key is used (and a warning is logged) -
# always set your own for production. The browser gets the same values from
# GET /secure-config.js, so changing them here is all that's needed.
ENCRYPTION_KEY=
ENCRYPTION_IV=
# Set to "false" to switch API encryption off entirely (debugging)
ENCRYPTION_ENABLED=true
# Set to "true" to also accept un-encrypted JSON request bodies (e.g. curl/Postman
# during development). Responses are still encrypted.
ALLOW_PLAINTEXT_REQUESTS=false
